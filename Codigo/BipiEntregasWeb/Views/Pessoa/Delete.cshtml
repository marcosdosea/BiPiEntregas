@model BipiEntregasWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Desativar Pessoa";
}

<h1>Desativar Pessoa</h1>

<h3>Tem certeza de que deseja desativar esta pessoa?</h3>

<p class="text-muted">
    O cadastro será mantido no sistema,
    mas sua situação será alterada para Inativo
    e ela não poderá mais acessar a plataforma.
</p>

<div>
    <h4>Dados Pessoais</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Nome)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Cpf)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Cpf)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Email)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Papel)
        </dt>
        <dd class="col-sm-10">
            @(Model.Papel == "S" ? "Solicitante" :
              Model.Papel == "E" ? "Entregador" :
              Model.Papel == "A" ? "Administrador" : "Desconhecido")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @(Model.Status == "A" ? "Ativo" :
              Model.Status == "I" ? "Inativo" :
              Model.Status == "P" ? "Pendente" : "Desconhecido")
        </dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mt-3">
            <input type="submit"
                   value="Confirmar Desativação"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>
