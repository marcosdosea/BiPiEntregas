@model BipiEntregasWeb.Models.PessoaViewModel

@{
    ViewData["Title"] = "Criar Conta";
}

<h1>Criar Conta</h1>

<h4>Dados Pessoais</h4>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly"
                 class="text-danger"></div>

            <div class="form-group">
                <label asp-for="Nome" class="control-label"></label>
                <input asp-for="Nome" class="form-control"
                       placeholder="Digite seu nome completo" />
                <span asp-validation-for="Nome" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Cpf" class="control-label"></label>
                <input asp-for="Cpf" class="form-control"
                       placeholder="Somente números" />
                <span asp-validation-for="Cpf" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Email" class="control-label"></label>
                <input asp-for="Email" class="form-control"
                       placeholder="Digite seu e-mail" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="Telefone" class="control-label"></label>
                <input asp-for="Telefone" class="form-control"
                       placeholder="DDD + número" />
                <span asp-validation-for="Telefone" class="text-danger"></span>
            </div>

            <div class="form-group mt-2">
                <label asp-for="DataNascimento" class="control-label"></label>
                <input asp-for="DataNascimento" class="form-control" />
                <span asp-validation-for="DataNascimento"
                      class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Papel" class="control-label"></label>

                <div class="form-check border p-3 mt-1">
                    <input asp-for="Papel" type="radio" value="S"
                           class="form-check-input ms-0 me-2" id="papelSolicitante" />
                    <label class="form-check-label" for="papelSolicitante">
                        Solicitante — quero enviar e receber encomendas
                    </label>
                </div>

                <div class="form-check border p-3 mt-2">
                    <input asp-for="Papel" type="radio" value="E"
                           class="form-check-input ms-0 me-2" id="papelEntregador" />
                    <label class="form-check-label" for="papelEntregador">
                        Entregador — quero realizar entregas
                    </label>
                </div>

                <span asp-validation-for="Papel" class="text-danger"></span>
            </div>

            <p class="text-muted mt-3">
                Cadastros de entregador ficam pendentes até a validação
                dos documentos pelo administrador.
            </p>

            <div class="form-group mt-3">
                <input type="submit" value="Criar Conta"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Voltar à Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync(
            "_ValidationScriptsPartial");
    }
}
