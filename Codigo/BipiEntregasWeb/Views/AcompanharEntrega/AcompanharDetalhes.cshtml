@model BipiEntregasWeb.Models.SolicitacaoEntregaViewModel

@{
    ViewData["Title"] = "Acompanhar pedido";

    var pendente = Model.Status == "PENDENTE";
    var emAndamento = Model.Status == "EM_ANDAMENTO";
    var concluida = Model.Status == "CONCLUIDA";
    var cancelada = Model.Status == "CANCELADA";

    var statusTexto = Model.Status switch
    {
        "PENDENTE" => "Aguardando entregador",
        "EM_ANDAMENTO" => "Em rota de entrega",
        "CONCLUIDA" => "Entregue",
        "CANCELADA" => "Cancelada",
        _ => "Situação indisponível"
    };
}

<style>
    .csu05-detalhes {
        max-width: 820px;
        margin: 0 auto;
    }

        .csu05-detalhes .csu05-topo {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1.5rem;
            margin-bottom: 1.75rem;
        }

        .csu05-detalhes .csu05-painel {
            border: 1px solid #dee2e6;
            border-radius: .8rem;
            background: #fff;
            padding: 1.5rem;
            margin-bottom: 1.5rem;
        }

        .csu05-detalhes .csu05-legenda {
            color: #6c757d;
            font-size: .78rem;
            text-transform: uppercase;
            letter-spacing: .07em;
            margin-bottom: .35rem;
        }

        .csu05-detalhes .csu05-divisao {
            border-bottom: 1px solid #e5e7eb;
            padding-bottom: 1rem;
            margin-bottom: 1rem;
        }

        .csu05-detalhes .csu05-etapas {
            list-style: none;
            margin: 0;
            padding: 0;
        }

            .csu05-detalhes .csu05-etapas li {
                position: relative;
                display: flex;
                gap: 1rem;
                padding: 0 0 1.7rem;
            }

                .csu05-detalhes .csu05-etapas li:last-child {
                    padding-bottom: 0;
                }

                .csu05-detalhes .csu05-etapas li:not(:last-child)::before {
                    content: "";
                    position: absolute;
                    top: 2.3rem;
                    bottom: 0;
                    left: 1.05rem;
                    border-left: 2px solid #ced4da;
                }

        .csu05-detalhes .csu05-marcador {
            display: flex;
            align-items: center;
            justify-content: center;
            flex: 0 0 2.2rem;
            width: 2.2rem;
            height: 2.2rem;
            border: 2px solid #adb5bd;
            border-radius: .5rem;
            background: #fff;
            font-weight: 700;
            z-index: 1;
        }

        .csu05-detalhes .csu05-concluida .csu05-marcador {
            background: #d1e7dd;
            border-color: #198754;
            color: #146c43;
        }

        .csu05-detalhes .csu05-atual .csu05-marcador {
            background: #dbeafe;
            border-color: #0d6efd;
            color: #084298;
        }

        .csu05-detalhes .csu05-inativa {
            color: #6c757d;
        }

        .csu05-detalhes .csu05-etapas p {
            margin-bottom: .25rem;
        }

        .csu05-detalhes .csu05-voltar {
            text-decoration: none;
            font-weight: 600;
        }
</style>

<section class="csu05-detalhes pb-5" aria-labelledby="csu05-detalhes-titulo">
    <header class="csu05-topo">
        <a class="csu05-voltar" asp-controller="SolicitacaoEntrega" asp-action="Acompanhar">&larr; Voltar aos pedidos</a>
        <h1 class="h2 text-center mt-2 mb-1" id="csu05-detalhes-titulo">Acompanhar pedido</h1>
        <p class="text-muted text-center mb-0">BIP-@Model.Id</p>
    </header>

    <div class="csu05-painel">
        <div class="csu05-divisao">
            <p class="csu05-legenda">Local de partida</p>
            <p class="fw-semibold mb-0">@Model.RuaOrigem, @Model.NumeroOrigem — @Model.BairroOrigem, @Model.CidadeOrigem</p>
            <p class="text-muted small mb-0">CEP: @Model.CepOrigem</p>
        </div>
        <div>
            <p class="csu05-legenda">Destino</p>
            <p class="fw-semibold mb-0">@Model.RuaDestino, @Model.NumeroDestino — @Model.BairroDestino, @Model.CidadeDestino</p>
            <p class="text-muted small mb-0">CEP: @Model.CepDestino</p>
        </div>
    </div>

    <div class="csu05-painel">
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
            <h2 class="h5 mb-0">Status da entrega</h2>
            <span class="badge @(concluida ? "text-bg-success" : cancelada ? "text-bg-danger" : emAndamento ? "text-bg-primary" : "text-bg-secondary")">@statusTexto</span>
        </div>

        @if (cancelada)
        {
            <div class="alert alert-danger mb-0" role="status">Esta solicitação foi cancelada. O acompanhamento não está mais disponível.</div>
        }
        else
        {
            <ol class="csu05-etapas" aria-label="Etapas da entrega">
                <li class="csu05-concluida">
                    <span class="csu05-marcador" aria-hidden="true">1</span>
                    <div>
                        <p class="fw-bold">Solicitação registrada</p>
                        <p class="text-muted">O pedido foi registrado no sistema.</p>
                        <small class="text-muted">@Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")</small>
                    </div>
                </li>
                <li class="@(emAndamento || concluida ? "csu05-concluida" : "csu05-inativa")">
                    <span class="csu05-marcador" aria-hidden="true">2</span>
                    <div>
                        <p class="fw-bold">Entrega em andamento</p>
                        <p class="text-muted">@(emAndamento || concluida ? "A solicitação está em rota." : "Aguardando início da rota.")</p>
                        <small class="text-muted">Horário desta etapa não informado</small>
                    </div>
                </li>
                <li class="@(concluida ? "csu05-concluida" : "csu05-inativa")">
                    <span class="csu05-marcador" aria-hidden="true">3</span>
                    <div>
                        <p class="fw-bold">Entrega concluída</p>
                        <p class="text-muted">@(concluida ? "Solicitação marcada como concluída." : "Aguardando confirmação de conclusão.")</p>
                        <small class="text-muted">Horário de conclusão não informado</small>
                    </div>
                </li>
            </ol>
        }
    </div>

    <div class="csu05-painel">
        <h2 class="h5 mb-3">Informações da encomenda</h2>
        <dl class="row mb-0">
            <dt class="col-sm-4">Descrição</dt>
            <dd class="col-sm-8">@Model.DescricaoItem</dd>
            <dt class="col-sm-4">Peso</dt>
            <dd class="col-sm-8">@Model.Peso.ToString("N2") kg</dd>
            <dt class="col-sm-4">Dimensões</dt>
            <dd class="col-sm-8">@Model.Dimensoes</dd>
            <dt class="col-sm-4">Frete</dt>
            <dd class="col-sm-8">@Model.ValorFrete.ToString("C")</dd>
        </dl>
    </div>

    @if (pendente || emAndamento)
    {
        <p class="text-muted small" role="status">
            Esta página verifica novamente o status a cada 30 segundos. A localização em tempo real ainda não está disponível no banco de dados atual.
        </p>
    }

    @if (concluida)
    {
        <p class="text-muted small">A avaliação do entregador estará disponível quando o recurso de avaliação for implementado.</p>
    }

    <a asp-controller="SolicitacaoEntrega" asp-action="Acompanhar" class="btn btn-outline-dark w-100">Voltar aos pedidos</a>
</section>

@section Scripts {
    @if (pendente || emAndamento)
    {
        <script>
            window.setTimeout(function () { window.location.reload(); }, 30000);
        </script>
    }
}