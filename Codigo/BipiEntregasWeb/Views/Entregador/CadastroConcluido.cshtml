@{
    ViewData["Title"] = "Cadastro enviado";
}

<div class="container py-5 text-center">
    <h1>Solicitação enviada com sucesso!</h1>

    <p>
        Seus documentos foram recebidos e seu cadastro
        de entregador está aguardando análise do administrador.
    </p>

    <p>
        Você poderá realizar entregas somente após
        a aprovação do seu cadastro.
    </p>

    <p>
        Enquanto isso, seu perfil de solicitante
        continua ativo.
    </p>

    <a asp-controller="Home"
       asp-action="Index"
       class="btn btn-primary">
        Voltar ao início
    </a>
</div>
