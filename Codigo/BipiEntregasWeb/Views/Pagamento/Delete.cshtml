@model BipiEntregasWeb.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Estornar Pagamento";
}

<h1>Estornar Pagamento</h1>

<h3>Tem certeza de que deseja estornar este pagamento?</h3>

<p class="text-muted">
    O pagamento será mantido no sistema,
    mas sua situação será alterada para Estornado.
    Somente pagamentos pendentes ou aprovados podem ser estornados.
</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div>
    <h4>Dados do Pagamento</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.IdSolicitacaoEntrega)
        </dt>
        <dd class="col-sm-10">
            BIP-@Model.IdSolicitacaoEntrega
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Valor)
        </dt>
        <dd class="col-sm-10">
            @Model.Valor.ToString("C")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Tipo)
        </dt>
        <dd class="col-sm-10">
            @(Model.Tipo == "C" ? "Cartão" :
              Model.Tipo == "P" ? "Pix" : "Desconhecido")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @(Model.Status == "P" ? "Pendente" :
              Model.Status == "A" ? "Aprovado" :
              Model.Status == "R" ? "Recusado" :
              Model.Status == "E" ? "Estornado" : "Desconhecido")
        </dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mt-3">
            <input type="submit"
                   value="Confirmar Estorno"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-secondary">
                Cancelar
            </a>
        </div>
    </form>
</div>