@model BipiEntregasWeb.Models.PagamentoViewModel

@{
    ViewData["Title"] = "Editar Pagamento";
}

<h1>Editar Pagamento</h1>

<h4>Dados do Pagamento</h4>
<p class="text-muted">Somente pagamentos pendentes podem ser alterados.</p>
<hr />

<div class="row">
    <div class="col-md-4">
        <form asp-action="Edit" asp-route-id="@Model.Id" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="form-group">
                <label asp-for="IdSolicitacaoEntrega" class="control-label"></label>
                <input asp-for="IdSolicitacaoEntrega" class="form-control" readonly />
            </div>

            <div class="form-group">
                <label asp-for="Valor" class="control-label"></label>
                <input asp-for="Valor" class="form-control" step="0.01" />
                <span asp-validation-for="Valor" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label asp-for="Tipo" class="control-label"></label>

                <div class="form-check border p-3 mt-1">
                    <input asp-for="Tipo" type="radio" value="C"
                           class="form-check-input ms-0 me-2" id="tipoCartao" />
                    <label class="form-check-label" for="tipoCartao">
                        Cartão
                    </label>
                </div>

                <div class="form-check border p-3 mt-2">
                    <input asp-for="Tipo" type="radio" value="P"
                           class="form-check-input ms-0 me-2" id="tipoPix" />
                    <label class="form-check-label" for="tipoPix">
                        Pix
                    </label>
                </div>

                <span asp-validation-for="Tipo" class="text-danger"></span>
            </div>

            <div class="form-group mt-3">
                <label class="control-label">Situação do Pagamento</label>
                <input class="form-control"
                       value="@(Model.Status == "P" ? "Pendente" :
                                Model.Status == "A" ? "Aprovado" :
                                Model.Status == "R" ? "Recusado" :
                                Model.Status == "E" ? "Estornado" : "Desconhecido")"
                       readonly />
            </div>

            <div class="form-group mt-3">
                <input type="submit"
                       value="Salvar Alterações"
                       class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div class="mt-3">
    <a asp-action="Index">Voltar à Lista</a>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}