@model BipiEntregasWeb.Models.SolicitacaoEntregaViewModel

@{
    ViewData["Title"] = "Cancelar Solicitação";
}

<h1>Cancelar Solicitação</h1>

<h3>Tem certeza de que deseja cancelar esta solicitação?</h3>

<p class="text-muted">
    A solicitação será mantida no sistema,
    mas sua situação será alterada para Cancelada.
    Só é possível cancelar solicitações aguardando entregador.
</p>

<div asp-validation-summary="ModelOnly" class="text-danger"></div>

<div>
    <h4>BIP-@Model.Id</h4>
    <hr />

    <dl class="row">
        <dt class="col-sm-2">Origem</dt>
        <dd class="col-sm-10">
            @Model.RuaOrigem, @Model.NumeroOrigem — @Model.BairroOrigem, @Model.CidadeOrigem
        </dd>

        <dt class="col-sm-2">Destino</dt>
        <dd class="col-sm-10">
            @Model.RuaDestino, @Model.NumeroDestino — @Model.BairroDestino, @Model.CidadeDestino
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescricaoItem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescricaoItem)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @(Model.Status == "PENDENTE" ? "Aguardando Entregador" :
              Model.Status == "EM_ANDAMENTO" ? "Em rota de entrega" :
              Model.Status == "CONCLUIDA" ? "Entregue" :
              Model.Status == "CANCELADA" ? "Cancelada" : "Desconhecido")
        </dd>
    </dl>

    <form asp-action="Delete"
          asp-route-id="@Model.Id"
          method="post">

        @Html.AntiForgeryToken()

        <input type="hidden" asp-for="Id" />

        <div class="mt-3">
            <input type="submit"
                   value="Confirmar Cancelamento"
                   class="btn btn-danger" />

            <a asp-action="Index"
               class="btn btn-secondary">
                Voltar
            </a>
        </div>
    </form>
</div>