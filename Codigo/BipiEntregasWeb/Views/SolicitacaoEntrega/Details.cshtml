@model BipiEntregasWeb.Models.SolicitacaoEntregaViewModel

@{
    ViewData["Title"] = "Detalhes da Solicitação";
}

<h1>Acompanhar Pedido</h1>
<p class="text-muted">BIP-@Model.Id</p>

<div>
    <h4>Local de Partida</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Endereço</dt>
        <dd class="col-sm-10">
            @Model.RuaOrigem, @Model.NumeroOrigem — @Model.BairroOrigem, @Model.CidadeOrigem
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CepOrigem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CepOrigem)
        </dd>
    </dl>

    <h4>Destino</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">Endereço</dt>
        <dd class="col-sm-10">
            @Model.RuaDestino, @Model.NumeroDestino — @Model.BairroDestino, @Model.CidadeDestino
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.CepDestino)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.CepDestino)
        </dd>
    </dl>

    <h4>Embalagem</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DescricaoItem)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.DescricaoItem)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Dimensoes)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Dimensoes)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Peso)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Peso)
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.ValorFrete)
        </dt>
        <dd class="col-sm-10">
            @Model.ValorFrete.ToString("C")
        </dd>
    </dl>

    <h4>Status da Entrega</h4>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Status)
        </dt>
        <dd class="col-sm-10">
            @(Model.Status == "PENDENTE" ? "Aguardando Entregador" :
              Model.Status == "EM_ANDAMENTO" ? "Em rota de entrega" :
              Model.Status == "CONCLUIDA" ? "Entregue" :
              Model.Status == "CANCELADA" ? "Cancelada" : "Desconhecido")
        </dd>

        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.DataCriacao)
        </dt>
        <dd class="col-sm-10">
            @Model.DataCriacao.ToString("dd/MM/yyyy HH:mm")
        </dd>
    </dl>
</div>

<div>
    <a asp-action="Edit" asp-route-id="@Model.Id">Editar</a> |
    <a asp-action="Index">Voltar à Lista</a>
</div>